%global __brp_check_rpaths %{nil}
%global __requires_exclude ^libmpi
%global packname  precisionenvelope
%global packver   0.1.0
%global rlibdir   /usr/local/lib/R/library

Name:             R-CRAN-%{packname}
Version:          0.1.0
Release:          1%{?dist}%{?buildtag}
Summary:          Sharp Precision Envelopes for Outcomes Missing at Random

License:          BSD_3_clause + file LICENSE
URL:              https://cran.r-project.org/package=%{packname}
Source0:          %{url}&version=%{packver}#/%{packname}_%{packver}.tar.gz


BuildRequires:    R-devel >= 4.1.0
Requires:         R-core >= 4.1.0
BuildArch:        noarch
BuildRequires:    R-graphics 
BuildRequires:    R-grDevices 
BuildRequires:    R-stats 
Requires:         R-graphics 
Requires:         R-grDevices 
Requires:         R-stats 

%description
Computes the range of precision that can survive when an outcome or an
all-or-none block of variables is missing at random. For a stated overall
observation rate and a lower bound on the observation probability, the
package returns the smallest and largest efficient variance that any
admissible missingness mechanism can produce, the corresponding
information retention and standard error inflation, and whether a
precision requirement is guaranteed, depends on the allocation of
missingness, or cannot be met. It also plans minimum-cost targeted
recovery of missing outcomes, and estimates the envelope from data on a
partially observed continuous outcome by cross-fitted one-step estimation
with a refitted bootstrap band over a prespecified grid of observation
rates. The method is described in Nakamura (2026)
<doi:10.3390/stats9050110>.

%prep
%setup -q -c -n %{packname}

# fix end of executable files
find -type f -executable -exec grep -Iq . {} \; -exec sed -i -e '$a\' {} \;
# prevent binary stripping
[ -d %{packname}/src ] && find %{packname}/src -type f -exec \
  sed -i 's@/usr/bin/strip@/usr/bin/true@g' {} \; || true
[ -d %{packname}/src ] && find %{packname}/src/Make* -type f -exec \
  sed -i 's@-g0@@g' {} \; || true
# don't allow local prefix in executable scripts
find -type f -executable -exec sed -Ei 's@#!( )*/usr/local/bin@#!/usr/bin@g' {} \;

%build

%install

mkdir -p %{buildroot}%{rlibdir}
%{_bindir}/R CMD INSTALL -l %{buildroot}%{rlibdir} %{packname}
test -d %{packname}/src && (cd %{packname}/src; rm -f *.o *.so)
rm -f %{buildroot}%{rlibdir}/R.css
# remove buildroot from installed files
find %{buildroot}%{rlibdir} -type f -exec sed -i "s@%{buildroot}@@g" {} \;

%files
%{rlibdir}/%{packname}
