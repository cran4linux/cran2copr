BuildRequires:    R-CRAN-rlang 
BuildRequires:    R-stats 
BuildRequires:    R-CRAN-tibble 
BuildRequires:    R-CRAN-tidyr 
BuildRequires:    R-utils 
BuildRequires:    R-tools 
Requires:         R-CRAN-shiny >= 1.7.2
Requires:         R-CRAN-bs4Dash 
