%global __brp_check_rpaths %{nil}
%global __requires_exclude ^libmpi
%global packname  BasinmodlR
%global packver   0.1.0
%global rlibdir   /usr/local/lib/R/library

Name:             R-CRAN-%{packname}
Version:          0.1.0
Release:          1%{?dist}%{?buildtag}
Summary:          Burial and Thermal History Modelling of Sedimentary Basins

License:          GPL-3
URL:              https://cran.r-project.org/package=%{packname}
Source0:          %{url}&version=%{packver}#/%{packname}_%{packver}.tar.gz


BuildRequires:    R-devel >= 3.5.0
Requires:         R-core >= 3.5.0
BuildArch:        noarch
BuildRequires:    R-graphics 
BuildRequires:    R-grDevices 
BuildRequires:    R-stats 
BuildRequires:    R-utils 
Requires:         R-graphics 
Requires:         R-grDevices 
Requires:         R-stats 
Requires:         R-utils 

%description
Simulates the burial, compaction and thermal history of a sedimentary
basin in one dimension, for geologists and stratigraphers. A basin is
described by one row per stratigraphic unit and one row per erosion event,
from which deposition phases, hiatuses, layer stacks, maximum-burial
windows and grain (solid) thicknesses are derived. Compaction follows an
exponential porosity-depth law and is irreversible, so uplifted layers
keep the porosity acquired at their deepest burial. Temperatures follow
the steady-state conductive geotherm of a layered column with radiogenic
heat production. The methods follow the textbook treatment of Allen and
Allen (2013, ISBN:978-0-470-67377-5). Functions are included to draw a
composite figure of burial, temperature and hydrocarbon generation windows
and a petroleum system event chart.

%prep
%setup -q -c -n %{packname}

# fix end of executable files
find -type f -executable -exec grep -Iq . {} \; -exec sed -i -e '$a\' {} \;
# prevent binary stripping
[ -d %{packname}/src ] && find %{packname}/src -type f -exec \
  sed -i 's@/usr/bin/strip@/usr/bin/true@g' {} \; || true
[ -d %{packname}/src ] && find %{packname}/src/Make* -type f -exec \
  sed -i 's@-g0@@g' {} \; || true
# don't allow local prefix in executable scripts
find -type f -executable -exec sed -Ei 's@#!( )*/usr/local/bin@#!/usr/bin@g' {} \;

%build

%install

mkdir -p %{buildroot}%{rlibdir}
%{_bindir}/R CMD INSTALL -l %{buildroot}%{rlibdir} %{packname}
test -d %{packname}/src && (cd %{packname}/src; rm -f *.o *.so)
rm -f %{buildroot}%{rlibdir}/R.css
# remove buildroot from installed files
find %{buildroot}%{rlibdir} -type f -exec sed -i "s@%{buildroot}@@g" {} \;

%files
%{rlibdir}/%{packname}
