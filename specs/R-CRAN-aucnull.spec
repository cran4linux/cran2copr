%global __brp_check_rpaths %{nil}
%global __requires_exclude ^libmpi
%global packname  aucnull
%global packver   0.2.2
%global rlibdir   /usr/local/lib/R/library

Name:             R-CRAN-%{packname}
Version:          0.2.2
Release:          1%{?dist}%{?buildtag}
Summary:          Heller Test of Equal AUCs for a New Marker in Nested Models

License:          MIT + file LICENSE
URL:              https://cran.r-project.org/package=%{packname}
Source0:          %{url}&version=%{packver}#/%{packname}_%{packver}.tar.gz


BuildRequires:    R-devel >= 4.1.0
Requires:         R-core >= 4.1.0
BuildArch:        noarch
BuildRequires:    R-stats 
Requires:         R-stats 

%description
Tests whether new markers improve the area under the receiver operating
characteristic curve beyond established markers in nested models, using
the maximum rank correlation estimator and the weighted chi-square null
distribution of Heller, Seshan, Moskowitz and Gonen (2017)
<doi:10.1093/biostatistics/kxw045>. The weights are estimated from the
bootstrap covariance of the rank correlation estimate (or from a sandwich
formula) and the curvature of the kernel smoothed area. The null
hypothesis is that the best linear ordering of subjects does not use the
new markers, and the test keeps its asymptotic level under any strictly
increasing link. Clustered observations are handled by a cluster
bootstrap. The likelihood ratio test, Wald tests with a robust covariance
and the DeLong test are computed alongside for comparison.

%prep
%setup -q -c -n %{packname}

# fix end of executable files
find -type f -executable -exec grep -Iq . {} \; -exec sed -i -e '$a\' {} \;
# prevent binary stripping
[ -d %{packname}/src ] && find %{packname}/src -type f -exec \
  sed -i 's@/usr/bin/strip@/usr/bin/true@g' {} \; || true
[ -d %{packname}/src ] && find %{packname}/src/Make* -type f -exec \
  sed -i 's@-g0@@g' {} \; || true
# don't allow local prefix in executable scripts
find -type f -executable -exec sed -Ei 's@#!( )*/usr/local/bin@#!/usr/bin@g' {} \;

%build

%install

mkdir -p %{buildroot}%{rlibdir}
%{_bindir}/R CMD INSTALL -l %{buildroot}%{rlibdir} %{packname}
test -d %{packname}/src && (cd %{packname}/src; rm -f *.o *.so)
rm -f %{buildroot}%{rlibdir}/R.css
# remove buildroot from installed files
find %{buildroot}%{rlibdir} -type f -exec sed -i "s@%{buildroot}@@g" {} \;

%files
%{rlibdir}/%{packname}
