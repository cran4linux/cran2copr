%global __brp_check_rpaths %{nil}
%global __requires_exclude ^libmpi
%global packname  tokenusagedata
%global packver   0.1.0
%global rlibdir   /usr/local/lib/R/library

Name:             R-CRAN-%{packname}
Version:          0.1.0
Release:          1%{?dist}%{?buildtag}
Summary:          AI Token Prices, Context Windows and Model Sizes

License:          CC BY 4.0
URL:              https://cran.r-project.org/package=%{packname}
Source0:          %{url}&version=%{packver}#/%{packname}_%{packver}.tar.gz


BuildRequires:    R-devel >= 3.5
Requires:         R-core >= 3.5
BuildArch:        noarch

%description
Provides five documented data frames for analysing artificial intelligence
(AI) model application programming interface (API) prices, published
context windows, and published or estimated parameter counts. Fixed
October 2026 snapshots retain source URLs and qualifications and add typed
dates and numeric quantities for reproducible comparisons and teaching.
Data are from Pistachio Technology Inc. (2026), published at
<https://tokenusage.dev/publications>: API prices
<doi:10.5281/zenodo.23552904>, context windows
<doi:10.5281/zenodo.23552975>, and model sizes
<doi:10.5281/zenodo.23553072>. These are selected historical records;
estimated sizes are distinguished from lab disclosures.

%prep
%setup -q -c -n %{packname}

# fix end of executable files
find -type f -executable -exec grep -Iq . {} \; -exec sed -i -e '$a\' {} \;
# prevent binary stripping
[ -d %{packname}/src ] && find %{packname}/src -type f -exec \
  sed -i 's@/usr/bin/strip@/usr/bin/true@g' {} \; || true
[ -d %{packname}/src ] && find %{packname}/src/Make* -type f -exec \
  sed -i 's@-g0@@g' {} \; || true
# don't allow local prefix in executable scripts
find -type f -executable -exec sed -Ei 's@#!( )*/usr/local/bin@#!/usr/bin@g' {} \;

%build

%install

mkdir -p %{buildroot}%{rlibdir}
%{_bindir}/R CMD INSTALL -l %{buildroot}%{rlibdir} %{packname}
test -d %{packname}/src && (cd %{packname}/src; rm -f *.o *.so)
rm -f %{buildroot}%{rlibdir}/R.css
# remove buildroot from installed files
find %{buildroot}%{rlibdir} -type f -exec sed -i "s@%{buildroot}@@g" {} \;

%files
%{rlibdir}/%{packname}
