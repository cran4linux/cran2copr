%description
Fits birth-death models of species diversification in which the speciation
and extinction rates depend on covariates generated by the process itself,
such as the number of lineages, the age structure of the lineages and
their evolutionary distinctiveness, to reconstructed phylogenies that
contain only extant species. The likelihood is integrated over the
unobserved extinct lineages by importance sampling on augmented trees, and
the parameters are estimated by Monte Carlo expectation-maximization, by
the cross-entropy method, or from a generalized additive model fitted to a
simulated likelihood surface, following Richter, Haegeman, Etienne and Wit
(2020) <doi:10.1111/stan.12205>. Trees can be simulated under the same
models, and incomplete taxon sampling is supported.

%prep
%setup -q -c -n %{packname}

# fix end of executable files
find -type f -executable -exec grep -Iq . {} \; -exec sed -i -e '$a\' {} \;
# prevent binary stripping
[ -d %{packname}/src ] && find %{packname}/src -type f -exec \
  sed -i 's@/usr/bin/strip@/usr/bin/true@g' {} \; || true
[ -d %{packname}/src ] && find %{packname}/src/Make* -type f -exec \
  sed -i 's@-g0@@g' {} \; || true
# don't allow local prefix in executable scripts
find -type f -executable -exec sed -Ei 's@#!( )*/usr/local/bin@#!/usr/bin@g' {} \;

%build

%install

mkdir -p %{buildroot}%{rlibdir}
%{_bindir}/R CMD INSTALL -l %{buildroot}%{rlibdir} %{packname}
test -d %{packname}/src && (cd %{packname}/src; rm -f *.o *.so)
rm -f %{buildroot}%{rlibdir}/R.css
# remove buildroot from installed files
find %{buildroot}%{rlibdir} -type f -exec sed -i "s@%{buildroot}@@g" {} \;

%files
%{rlibdir}/%{packname}
