%global __brp_check_rpaths %{nil}
%global __requires_exclude ^libmpi
%global packname  fpoValue
%global packver   0.1.0
%global rlibdir   /usr/local/lib/R/library

Name:             R-CRAN-%{packname}
Version:          0.1.0
Release:          1%{?dist}%{?buildtag}
Summary:          Farmer Producer Organisation Economics and Member Benefit Accounting

License:          GPL (>= 3)
URL:              https://cran.r-project.org/package=%{packname}
Source0:          %{url}&version=%{packver}#/%{packname}_%{packver}.tar.gz


BuildRequires:    R-devel >= 3.5.0
Requires:         R-core >= 3.5.0
BuildArch:        noarch
BuildRequires:    R-graphics 
Requires:         R-graphics 

%description
Tools to determine when collective marketing, aggregation, grading and
bulk input procurement through farmer producer organisations (FPOs) and
agricultural cooperatives improve member-farmer returns. The package
provides channel-level transaction cost accounting (transport,
commissions, market fees, time, rejection and payment-delay costs),
estimation of scale economies from consolidated transport, tiered bulk
input discounts and grading premiums, break-even throughput and
procurement-price analysis, and comparison of individual and collective
marketing scenarios. Its core is a member-level distributional accounting
framework that separates the total surplus generated by an FPO from the
benefits actually received by farmers through prices, transaction cost
savings, input savings and dividends, and summarises their distribution
across members with Gini and concentration indices and farm-size group
shares.

%prep
%setup -q -c -n %{packname}

# fix end of executable files
find -type f -executable -exec grep -Iq . {} \; -exec sed -i -e '$a\' {} \;
# prevent binary stripping
[ -d %{packname}/src ] && find %{packname}/src -type f -exec \
  sed -i 's@/usr/bin/strip@/usr/bin/true@g' {} \; || true
[ -d %{packname}/src ] && find %{packname}/src/Make* -type f -exec \
  sed -i 's@-g0@@g' {} \; || true
# don't allow local prefix in executable scripts
find -type f -executable -exec sed -Ei 's@#!( )*/usr/local/bin@#!/usr/bin@g' {} \;

%build

%install

mkdir -p %{buildroot}%{rlibdir}
%{_bindir}/R CMD INSTALL -l %{buildroot}%{rlibdir} %{packname}
test -d %{packname}/src && (cd %{packname}/src; rm -f *.o *.so)
rm -f %{buildroot}%{rlibdir}/R.css
# remove buildroot from installed files
find %{buildroot}%{rlibdir} -type f -exec sed -i "s@%{buildroot}@@g" {} \;

%files
%{rlibdir}/%{packname}
