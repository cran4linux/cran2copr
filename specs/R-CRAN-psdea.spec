%global __brp_check_rpaths %{nil}
%global __requires_exclude ^libmpi
%global packname  psdea
%global packver   1.0.0
%global rlibdir   /usr/local/lib/R/library

Name:             R-CRAN-%{packname}
Version:          1.0.0
Release:          1%{?dist}%{?buildtag}
Summary:          Data Envelopment Analysis with User-Defined and Learned Reference Sets

License:          GPL-3
URL:              https://cran.r-project.org/package=%{packname}
Source0:          %{url}&version=%{packver}#/%{packname}_%{packver}.tar.gz


BuildRequires:    R-devel >= 4.0
Requires:         R-core >= 4.0
BuildArch:        noarch
BuildRequires:    R-utils 
Requires:         R-utils 

%description
Slacks-based data envelopment analysis for panel data in which the
reference set is an explicit argument.  A user-supplied weight matrix, or
a matrix learned from the data by penalised non-negative reconstruction,
selects the units that may enter each decision-making unit's frontier.
The package reports the unrestricted and the restricted score, the ratio
of the two and an exact decomposition of the shortfall into the part the
restricted technology can remove and the part it cannot.  Moran's I and
local indicators of spatial association are provided as diagnostics.  All
linear programs are solved by a two-phase simplex with Bland's rule
implemented in R, so the package needs no compiler.

%prep
%setup -q -c -n %{packname}

# fix end of executable files
find -type f -executable -exec grep -Iq . {} \; -exec sed -i -e '$a\' {} \;
# prevent binary stripping
[ -d %{packname}/src ] && find %{packname}/src -type f -exec \
  sed -i 's@/usr/bin/strip@/usr/bin/true@g' {} \; || true
[ -d %{packname}/src ] && find %{packname}/src/Make* -type f -exec \
  sed -i 's@-g0@@g' {} \; || true
# don't allow local prefix in executable scripts
find -type f -executable -exec sed -Ei 's@#!( )*/usr/local/bin@#!/usr/bin@g' {} \;

%build

%install

mkdir -p %{buildroot}%{rlibdir}
%{_bindir}/R CMD INSTALL -l %{buildroot}%{rlibdir} %{packname}
test -d %{packname}/src && (cd %{packname}/src; rm -f *.o *.so)
rm -f %{buildroot}%{rlibdir}/R.css
# remove buildroot from installed files
find %{buildroot}%{rlibdir} -type f -exec sed -i "s@%{buildroot}@@g" {} \;

%files
%{rlibdir}/%{packname}
