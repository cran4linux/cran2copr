%global __brp_check_rpaths %{nil}
%global __requires_exclude ^libmpi
%global packname  chiplot
%global packver   0.1.0
%global rlibdir   /usr/local/lib/R/library

Name:             R-CRAN-%{packname}
Version:          0.1.0
Release:          1%{?dist}%{?buildtag}
Summary:          Chi-Plots for Assessing Bivariate and Multivariate Dependence

License:          GPL (>= 2)
URL:              https://cran.r-project.org/package=%{packname}
Source0:          %{url}&version=%{packver}#/%{packname}_%{packver}.tar.gz


BuildRequires:    R-devel >= 4.0.0
Requires:         R-core >= 4.0.0
BuildRequires:    R-graphics 
BuildRequires:    R-grDevices 
BuildRequires:    R-stats 
Requires:         R-graphics 
Requires:         R-grDevices 
Requires:         R-stats 

%description
Graphical methods for assessing dependence. The chi-plot of Fisher and
Switzer (1985) <doi:10.1093/biomet/72.2.253> and (2001)
<doi:10.1198/000313001317098248> supplements a scatterplot of two
variables, producing characteristic patterns for different forms of
association. Its multivariate extension (Fisher and Lee, 2026) uses
generalized orthants and data depth to explore whether a multivariate
distribution factorizes into independent blocks of variables, with
permutation tests and guidelines. Functions are provided for single
chi-plots, a scatterplot matrix with chi-plots above the diagonal,
multivariate chi-plots for a given partition of the variables, and a
search over all partitions. Computation-intensive parts are written in C.

%prep
%setup -q -c -n %{packname}

# fix end of executable files
find -type f -executable -exec grep -Iq . {} \; -exec sed -i -e '$a\' {} \;
# prevent binary stripping
[ -d %{packname}/src ] && find %{packname}/src -type f -exec \
  sed -i 's@/usr/bin/strip@/usr/bin/true@g' {} \; || true
[ -d %{packname}/src ] && find %{packname}/src/Make* -type f -exec \
  sed -i 's@-g0@@g' {} \; || true
# don't allow local prefix in executable scripts
find -type f -executable -exec sed -Ei 's@#!( )*/usr/local/bin@#!/usr/bin@g' {} \;

%build

%install

mkdir -p %{buildroot}%{rlibdir}
%{_bindir}/R CMD INSTALL -l %{buildroot}%{rlibdir} %{packname}
test -d %{packname}/src && (cd %{packname}/src; rm -f *.o *.so)
rm -f %{buildroot}%{rlibdir}/R.css
# remove buildroot from installed files
find %{buildroot}%{rlibdir} -type f -exec sed -i "s@%{buildroot}@@g" {} \;

%files
%{rlibdir}/%{packname}
