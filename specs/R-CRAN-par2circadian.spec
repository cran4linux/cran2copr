%global __brp_check_rpaths %{nil}
%global __requires_exclude ^libmpi
%global packname  par2circadian
%global packver   0.1.1
%global rlibdir   /usr/local/lib/R/library

Name:             R-CRAN-%{packname}
Version:          0.1.1
Release:          1%{?dist}%{?buildtag}
Summary:          AR(2) Eigenvalue Persistence Analysis of Circadian Time Series

License:          Apache License (>= 2)
URL:              https://cran.r-project.org/package=%{packname}
Source0:          %{url}&version=%{packver}#/%{packname}_%{packver}.tar.gz


BuildRequires:    R-devel >= 3.6.0
Requires:         R-core >= 3.6.0
BuildArch:        noarch
BuildRequires:    R-stats 
Requires:         R-stats 

%description
Estimates temporal persistence in gene expression time series by fitting a
second-order autoregressive model per gene and reporting the eigenvalue
modulus of its characteristic equation. Conventional circadian methods
answer whether a gene cycles; the eigenvalue modulus instead measures how
strongly recent expression constrains future expression, which separates
clock genes from their targets and from background in intact tissue.
Provides single-series and matrix-wide fitting, root-type classification,
half-life and intrinsic-period conversions, residual-bootstrap confidence
intervals for short series, and hierarchy summaries. Numerically
equivalent to the reference 'Python' implementation 'par2-circadian'. The
method is described in Whiteside (2026) <doi:10.21203/rs.3.rs-9283100/v1>.

%prep
%setup -q -c -n %{packname}

# fix end of executable files
find -type f -executable -exec grep -Iq . {} \; -exec sed -i -e '$a\' {} \;
# prevent binary stripping
[ -d %{packname}/src ] && find %{packname}/src -type f -exec \
  sed -i 's@/usr/bin/strip@/usr/bin/true@g' {} \; || true
[ -d %{packname}/src ] && find %{packname}/src/Make* -type f -exec \
  sed -i 's@-g0@@g' {} \; || true
# don't allow local prefix in executable scripts
find -type f -executable -exec sed -Ei 's@#!( )*/usr/local/bin@#!/usr/bin@g' {} \;

%build

%install

mkdir -p %{buildroot}%{rlibdir}
%{_bindir}/R CMD INSTALL -l %{buildroot}%{rlibdir} %{packname}
test -d %{packname}/src && (cd %{packname}/src; rm -f *.o *.so)
rm -f %{buildroot}%{rlibdir}/R.css
# remove buildroot from installed files
find %{buildroot}%{rlibdir} -type f -exec sed -i "s@%{buildroot}@@g" {} \;

%files
%{rlibdir}/%{packname}
